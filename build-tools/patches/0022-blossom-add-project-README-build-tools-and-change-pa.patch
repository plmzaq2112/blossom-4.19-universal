+#!/bin/bash
+# Local (WSL) adaptation of bn (6).sh for the sashimi tree.
+# All paths live inside ~/kernel-oc; nothing outside is touched.
+set -u
+
+KERNEL_DIR="$HOME/kernel-oc/sashimi_kernel_xiaomi_blossom"
+TOOLCHAINS="$HOME/kernel-oc/toolchains"
+CLANG_DIR="$TOOLCHAINS/neutron-clang"
+anykernel="$HOME/kernel-oc/anykernel/AnyKernel3"
+CCACHE_DIR_LOCAL="$HOME/kernel-oc/ccache"
+CONFIG_FILE="blossom_defconfig"
+ARCH="arm64"
+JOBS="$(nproc --all)"
+
+cd "$KERNEL_DIR" || exit 1
+
+# --- proxy for downloads (xray on Windows host) ---
+if [ -f "$HOME/kernel-oc/proxy.sh" ]; then . "$HOME/kernel-oc/proxy.sh"; fi
+
+mkdir -p "$TOOLCHAINS" "$CCACHE_DIR_LOCAL"
+
+# --- toolchain: Neutron clang taken from the original script ---
+if [ ! -x "$CLANG_DIR/bin/clang" ]; then
+  echo ">>> fetching Neutron clang into $CLANG_DIR"
+  mkdir -p "$CLANG_DIR" && cd "$CLANG_DIR" || exit 1
+  if [ ! -x antman ]; then
+    curl -fsSL -o antman "https://raw.githubusercontent.com/Neutron-Toolchains/antman/main/antman" || exit 1
+    chmod +x antman
+  fi
+  ./antman -S || { echo "!! antman failed"; exit 1; }
+  cd "$KERNEL_DIR" || exit 1
+fi
+
+if [ -x "$CLANG_DIR/bin/clang" ]; then
+  export PATH="$CLANG_DIR/bin:$PATH"
+  CC_BIN="$(command -v clang)"
+else
+  echo "!! neutron clang missing, falling back to system clang"
+  CC_BIN="$(command -v clang)"
+fi
+echo ">>> using clang: $CC_BIN"
+"$CC_BIN" --version | head -2
+
+export ARCH="$ARCH"
+export KBUILD_BUILD_USER="t.me"
+export KBUILD_BUILD_HOST="AnymoreProject"
+export USE_CCACHE=1
+export CCACHE_DIR="$CCACHE_DIR_LOCAL"
+export CCACHE="$(command -v ccache)"
+
+objdir="$KERNEL_DIR/out"
+
+# --- host build strings (equivalent of the mkcompile_h sed, without dirtying the tree) ---
+export KBUILD_BUILD_USER="xc112lg_+_zyexro"
+export KBUILD_BUILD_HOST="crave.io"
+
+echo ">>> make O=out mrproper"
+make O="$objdir" mrproper >/dev/null 2>&1 || echo "!! mrproper had issues, continuing"
+mkdir -p "$objdir"
+
+echo ">>> generating $CONFIG_FILE (O=out)"
+make -s ARCH="$ARCH" O="$objdir" "$CONFIG_FILE" || { echo "!! defconfig failed"; exit 1; }
+
+echo ">>> starting compile: -j$JOBS KCFLAGS=${EXTRA_KCFLAGS:-<default>}"
+BUILD_START=$(date +%s)
+answers=$'2\ny\ny\ny\ny\ny\ny\n'
+echo "$answers" | make -j"$JOBS" \
+    O="$objdir" \
+    ARCH="arm64" \
+    SUBARCH="arm64" \
+    DTC_EXT="dtc" \
+    CLANG_TRIPLE="aarch64-linux-gnu-" \
+    CROSS_COMPILE="aarch64-linux-gnu-" \
+    CROSS_COMPILE_ARM32="arm-linux-gnueabi-" \
+    CROSS_COMPILE_COMPAT="arm-linux-gnueabi-" \
+    LD="ld.lld" \
+    AR="llvm-ar" \
+    NM="llvm-nm" \
+    STRIP="llvm-strip" \
+    OBJCOPY="llvm-objcopy" \
+    OBJDUMP="llvm-objdump" \
+    READELF="llvm-readelf" \
+    HOSTCC="clang" \
+    HOSTCXX="clang++" \
+    HOSTAR="llvm-ar" \
+    HOSTLD="ld.lld" \
+    LLVM=1 \
+    LLVM_IAS=1 \
+    KCFLAGS="${EXTRA_KCFLAGS:-}" \
+    CC="ccache clang"
+rc=$?
+BUILD_END=$(date +%s)
+echo ">>> make exited with $rc after $((BUILD_END-BUILD_START))s"
+[ $rc -ne 0 ] && exit $rc
+
+# --- outputs ---
+image="$objdir/arch/arm64/boot/Image"
+dtb_img="$objdir/arch/arm64/boot/dtb.img"
+outdir="$KERNEL_DIR/newkernel"
+mkdir -p "$outdir"
+
+[ -f "$image" ] || { echo "!! no Image produced"; exit 1; }
+cp "$image" "$outdir/kernel"
+gzip -9 -f "$outdir/kernel"
+mv "$outdir/kernel.gz" "$outdir/kernel"
+
+# NOTE: the DTB produced by this tree does not boot on this unit (LK crashes while
+# loading it).  The known-good DTB is the one from the 1020 stock boot image.
+REF_DTB="$HOME/kernel-oc/logs/refs/1020boot.dtb"
+if [ -f "$REF_DTB" ]; then
+  cp "$REF_DTB" "$outdir/dtb.img"
+  echo ">>> dtb from known-good reference: $REF_DTB"
+else
+  echo "!! WARNING: $REF_DTB missing, falling back to freshly built DTB (may not boot)"
+  for cand in "$dtb_img" "$objdir/arch/arm64/boot/mtk.dtb" \
+              "$objdir/arch/arm64/boot/dts/mediatek/mt6765.dtb"; do
+    if [ -f "$cand" ]; then cp "$cand" "$outdir/dtb.img"; echo ">>> dtb from $cand"; break; fi
+  done
+fi
+ls -lh "$outdir"
+
+# --- AnyKernel3 zip ---
+if [ ! -f "$anykernel/tools/ak3-core.sh" ]; then
+  mkdir -p "$(dirname "$anykernel")"
+  git -c http.proxy="${http_proxy:-}" clone --depth=1 https://github.com/osm0sis/AnyKernel3 "$anykernel" || exit 1
+fi
+cd "$anykernel" || exit 1
+rm -f Image Image.gz Image.gz-dtb dtb *.zip
+gzip -9 -c "$image" > Image.gz
+[ -f "$outdir/dtb.img" ] && cp "$outdir/dtb.img" dtb
+
+cat > anykernel.sh <<'AKEOF'
+### AnyKernel3 Ramdisk Mod Script
+properties() { '
+kernel.string=Blossom kernel
+do.devicecheck=1
+do.modules=0
+do.systemless=0
+do.cleanup=1
+do.cleanuponabort=0
+device.name1=blossom
+device.name2=dandelion
+device.name3=angelica
+device.name4=angelican
+device.name5=angelicain
+device.name6=cattail
+supported.versions=
+supported.patchlevels=
+supported.vendorpatchlevels=
+'; }
+
+BLOCK=/dev/block/by-name/boot;
+IS_SLOT_DEVICE=0;
+RAMDISK_COMPRESSION=auto;
+PATCH_VBMETA_FLAG=auto;
+
+. tools/ak3-core.sh;
+
+# (backup left to the user: back up boot + dtbo before flashing)
+split_boot;
+flash_boot;
+AKEOF
+
+ZIPNAME="Blossom-Kernel-$(date +%Y%m%d-%H%M).zip"
+zip -r9 "$ZIPNAME" . -x ".git*" "README*" "*.md" "*.zip" >/dev/null || exit 1
+mkdir -p "$KERNEL_DIR/newkernel"
+cp "$ZIPNAME" "$KERNEL_DIR/newkernel/"
+echo ">>> flashable zip: $KERNEL_DIR/newkernel/$ZIPNAME"
+cd "$KERNEL_DIR" || exit 1
diff --git a/build-tools/edit_cmdline.py b/build-tools/edit_cmdline.py
new file mode 100755
index 000000000..163c04796
--- /dev/null
+++ b/build-tools/edit_cmdline.py
@@ -0,0 +1,13 @@
+#!/usr/bin/env python3
+"""edit_cmdline.py in.img out.img remove_prefix"""
+import struct, pathlib, sys
+src, dst, prefix = sys.argv[1], sys.argv[2], sys.argv[3]
+b = bytearray(pathlib.Path(src).read_bytes())
+if b[:8] != b"ANDROID!":
+    sys.exit("not boot image")
+cmd = bytes(b[64:64+512]).split(b"\0")[0].decode()
+parts = [p for p in cmd.split() if not p.startswith(prefix)]
+new = " ".join(parts).encode()
+b[64:64+512] = new + b"\0" * (512 - len(new))
+pathlib.Path(dst).write_bytes(b)
+print("cmdline:", new.decode())
diff --git a/build-tools/pack_boot.py b/build-tools/pack_boot.py
new file mode 100755
index 000000000..0686e814d
--- /dev/null
+++ b/build-tools/pack_boot.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""pack_boot.py BASE.img KERNEL.gz DTB OUT.img  — keep ramdisk/cmdline/AVB footer."""
+import struct, pathlib, hashlib, sys
+
+base_p, kernel_p, dtb_p, out_p = [pathlib.Path(x) for x in sys.argv[1:5]]
+base = base_p.read_bytes()[:67108864]
+kernel = kernel_p.read_bytes()
+dtb = dtb_p.read_bytes()
+
+ksize, kaddr, rsize, raddr, ssize, saddr, tags, page, hver = struct.unpack_from("<9I", base, 8)
+rec_size, rec_off = struct.unpack_from("<IQ", base, 1632)
+hsize, dsize = struct.unpack_from("<II", base, 1644)
+assert page == 2048 and hver == 2, (page, hver)
+
+def al(x): return (x + page - 1)//page*page
+old_roff = al(page + ksize)
+old_soff = al(old_roff + rsize)
+old_recoff = al(old_soff + ssize)
+old_doff = al(old_recoff + rec_size)
+ramdisk = base[old_roff:old_roff+rsize]
+second = base[old_soff:old_soff+ssize]
+rec = base[old_recoff:old_recoff+rec_size]
+
+koff = page
+roff = al(koff + len(kernel))
+soff = al(roff + len(ramdisk))
+recoff = al(soff + len(second))
+doff = al(recoff + len(rec))
+total = 67108864
+avb = base[total-64:total]
+assert avb[:4] == b"AVBf"
+
+img = bytearray(total)
+hdr = bytearray(base[:page])
+struct.pack_into("<I", hdr, 8, len(kernel))
+struct.pack_into("<I", hdr, 16, len(ramdisk))
+struct.pack_into("<I", hdr, 24, len(second))
+struct.pack_into("<I", hdr, 1648, len(dtb))
+img[:page] = hdr
+img[koff:koff+len(kernel)] = kernel
+img[roff:roff+len(ramdisk)] = ramdisk
+if second: img[soff:soff+len(second)] = second
+if rec: img[recoff:recoff+len(rec)] = rec
+img[doff:doff+len(dtb)] = dtb
+img[total-64:total] = avb
+out_p.write_bytes(img)
+print("wrote", out_p, len(img))
+print("kernel", len(kernel), hashlib.sha256(kernel).hexdigest()[:16])
+print("dtb   ", len(dtb), hashlib.sha256(dtb).hexdigest()[:16], "at", doff)
diff --git a/build-tools/port_oc.py b/build-tools/port_oc.py
new file mode 100755
index 000000000..b6192ebe2
--- /dev/null
+++ b/build-tools/port_oc.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+"""Port IsHacker-kernel's CPU overclock to the sashimi tree.
+
+IsHacker final state (branch master @0d7457d08):
+  C62/C62LY  L  2101 -> 2201 MHz @ Vproc 120 (1168750 uV in opp table)
+             LL 1500 -> 1700 MHz @ Vproc 120
+             CCI 1048 -> 1248 MHz @ Vproc 120
+  mt6765.dts: cluster0 2401 -> 2501 MHz, cluster1 1800 -> 2000 MHz, CCI 1051 -> 1251 MHz
+GPU OC is deliberately NOT touched: sashimi already runs 850/690/550 MHz
+(IsHacker only does 680/520/416).
+"""
+import sys, pathlib
+
+root = pathlib.Path.home() / "kernel-oc" / "sashimi_kernel_xiaomi_blossom"
+changed = []
+
+def sub_any(path, olds, new, count=1):
+    p = root / path
+    s = p.read_text()
+    for old in olds:
+        if s.count(old) >= count:
+            p.write_text(s.replace(old, new, count))
+            changed.append((path, old, new))
+            return
+    sys.exit(f"FAIL {path}: none of {olds!r} found")
+
+def sub_in_block(path, start_marker, end_marker, old, new):
+    p = root / path
+    s = p.read_text()
+    i = s.index(start_marker)
+    j = s.index(end_marker, i)
+    block = s[i:j]
+    if block.count(old) < 1:
+        sys.exit(f"FAIL {path} [{start_marker}]: {old!r} not found")
+    p.write_text(s[:i] + block.replace(old, new, 1) + s[j:])
+    changed.append((path + " [" + start_marker + "]", old, new))
+
+OPP = "drivers/misc/mediatek/base/power/cpufreq_v1/src/mach/mt6765/mtk_cpufreq_opp_table.h"
+PV  = "drivers/misc/mediatek/base/power/cpufreq_v1/src/mach/mt6765/mtk_cpufreq_opp_pv_table.h"
+DTS = "arch/arm64/boot/dts/mediatek/mt6765.dts"
+
+# 1. static tables used by the v1 cpufreq driver
+for suffix in ("C62", "C62LY"):
+    sub_any(OPP, [f"#define CPU_DVFS_FREQ0_L_{suffix}    2101000"], f"#define CPU_DVFS_FREQ0_L_{suffix}    2201000")
+    sub_any(OPP, [f"#define CPU_DVFS_FREQ0_LL_{suffix}    1500000"], f"#define CPU_DVFS_FREQ0_LL_{suffix}    1700000")
+    sub_any(OPP, [f"#define CPU_DVFS_FREQ0_CCI_{suffix}    1048000"], f"#define CPU_DVFS_FREQ0_CCI_{suffix}    1248000")
+    sub_any(OPP, [f"#define CPU_DVFS_VOLT0_VPROC_L_{suffix}    106875",
+                  f"#define CPU_DVFS_VOLT0_VPROC_L_{suffix}    111875"],
+            f"#define CPU_DVFS_VOLT0_VPROC_L_{suffix}    116875")
+    sub_any(OPP, [f"#define CPU_DVFS_VOLT0_VPROC_LL_{suffix}    102500",
+                  f"#define CPU_DVFS_VOLT0_VPROC_LL_{suffix}    111875"],
+            f"#define CPU_DVFS_VOLT0_VPROC_LL_{suffix}    116875")
+    sub_any(OPP, [f"#define CPU_DVFS_VOLT0_VPROC_CCI_{suffix}    106875",
+                  f"#define CPU_DVFS_VOLT0_VPROC_CCI_{suffix}    111875"],
+            f"#define CPU_DVFS_VOLT0_VPROC_CCI_{suffix}    116875")
+
+# 2. PV / hybrid tables
+for start, end in (("static unsigned int c62Tbl", "static unsigned int c62lyTbl"),
+                   ("static unsigned int c62lyTbl", "unsigned int *xrecordTbl")):
+    sub_in_block(PV, start, end, "{ 2101, 96, 1, 1 }", "{ 2201, 120, 1, 1 }")
+    sub_in_block(PV, start, end, "{ 1500, 96, 2, 1 }", "{ 1700, 120, 2, 1 }")
+    sub_in_block(PV, start, end, "{ 1048, 96, 2, 1 }", "{ 1248, 120, 2, 1 }")
+
+# 3. devicetree OPP tables
+sub_any(DTS, ["\t\t\topp-hz = /bits/ 64 <2401000000>;\n\t\t\topp-microvolt = <1068750>;"],
+        "\t\t\topp-hz = /bits/ 64 <2501000000>;\n\t\t\topp-microvolt = <1168750>;")
+sub_any(DTS, ["\t\t\topp-hz = /bits/ 64 <1800000000>;\n\t\t\topp-microvolt = <1025000>;"],
+        "\t\t\topp-hz = /bits/ 64 <2000000000>;\n\t\t\topp-microvolt = <1168750>;")
+sub_any(DTS, ["\t\t\topp-hz = /bits/ 64 <1051000000>;\n\t\t\topp-microvolt = <1068750>;"],
+        "\t\t\topp-hz = /bits/ 64 <1251000000>;\n\t\t\topp-microvolt = <1168750>;")
+sub_any(DTS, ["clock-frequency = <2401000000>;"], "clock-frequency = <2501000000>;", 4)
+sub_any(DTS, ["clock-frequency = <1800000000>;"], "clock-frequency = <2000000000>;", 4)
+
+print(f"{len(changed)} replacements applied:")
+for path, old, new in changed:
+    print("  ", path.split("/")[-1], "|", old.strip(), "->", new.strip())
