+&irq_nfc {
+	interrupt-parent = <&pio>;
+	interrupts = <10 IRQ_TYPE_LEVEL_HIGH 10 0>;
+	status = "okay";
+};
+
+&chr_stat {
+	interrupt-parent = <&pio>;
+	interrupts = <11 IRQ_TYPE_LEVEL_LOW 11 0>;
+	status = "okay";
+};
+
+&dsi_te {
+	interrupt-parent = <&pio>;
+	interrupts = <20 IRQ_TYPE_EDGE_RISING 20 0>;
+	status = "okay";
